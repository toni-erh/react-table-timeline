{
  "name": "react-table-timeline",
  "version": "0.1.0",
  "description": "Reusable React Table Timeline Component (TypeScript)",
  "author": "Toni Erhard",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/Table.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/Table.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "start": "vite",
    "host": "vite --host",
    "build": "vite build && tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepare": "npm run build",
    "test": "vitest"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
